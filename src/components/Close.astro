---
import LeakForm from './LeakForm.astro';
import { SITE } from '../data/site';
interface Props { head?: string; sub?: string; id?: string }
const { head = 'Get your free leak check.', sub = 'Send your website. Within a day you get a 2-minute video of where your ads and pages lose people, and what to fix first.', id = 'close' } = Astro.props;
---
<section class="close" id="check" aria-labelledby="check-h">
  <div class="close__panel on-dark">
  <div class="container close__grid">
    <div>
      <h2 id="check-h">{head}</h2>
      <p class="lead">{sub}</p>
      <LeakForm id={id} note="Free. No call and no obligation." />
    </div>
    <div class="close__side">
      <ul>
        <li><b>Within a day</b>A short video made from your own ads, pages and reply times.</li>
        <li><b>Rather talk first?</b><a href={SITE.calendly} target="_blank" rel="noopener">Book a 30-minute call</a></li>
        <li><b>Prefer email?</b><a href={`mailto:${SITE.email}?subject=Free%20leak%20check`}>{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  </div>
</section>
